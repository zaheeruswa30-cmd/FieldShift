# Copy to .env  (cp .env.example .env). Everything is OPTIONAL: the app works without any of it.

# --- Real emails for OTP codes (Gmail: turn on 2-Step Verification, then create an "App password") ---
# Easiest: run  npm run setup:mail  (it fills these for you). Verify anytime with  npm run test:mail
# After editing this file, STOP the app (Ctrl+C) and run  npm run dev  again.
# Leave empty = DEV mode: the 6-digit code is shown inside the app and printed in the terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Real "Continue with Google" (Google Cloud Console > Credentials > OAuth client ID > Web app,
#     Authorised JavaScript origin: http://localhost:5173). Use the SAME id in both lines. ---
# Easiest: run  npm run setup:google  (it fills both lines). Then restart npm run dev.
# Authorised JavaScript origins must include BOTH http://localhost:5173 and http://localhost
# Leave empty = demo Google account chooser.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Map: NASA GIBS + Esri/OSM basemaps need NO key. CARTO now requires a key, so it is only used if you set this (optional). ---
VITE_CARTO_KEY=

# --- NASA map: NO key is needed (GIBS + POWER are public). Only for future Earthdata datasets. ---
VITE_EARTHDATA_TOKEN=
